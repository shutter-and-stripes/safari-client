{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://safari-server-ikbh.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "shutter-and-stripes-frontend"
      }
    }
  ],
  "services": {
    "shutter-and-stripes-frontend": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm ci && npm run build"
    }
  }
}
